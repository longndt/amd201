# ── Render env vars for the PRODUCT (CRUD) service ───────────────────────────
# Render dashboard → your product service → Environment → "Add from .env" → paste.
# Replace every <PLACEHOLDER>. Do NOT commit real secrets.
# (No CORS here — only the gateway is browser-facing.)

# SQL Server connection string (can be the same DB server as Auth, or a separate one).
ConnectionStrings__DefaultConnection=Server=tcp:<YOUR_SERVER>.database.windows.net,1433;Initial Catalog=labdb;User ID=<USER>;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=False;

# JWT settings — copy the EXACT same values you set on the Auth service,
# otherwise every request returns 401 Unauthorized.
Jwt__Key=<SAME_SECRET_AS_AUTH_SERVICE>
Jwt__Issuer=MicroserviceLab
Jwt__Audience=MicroserviceLabClients
