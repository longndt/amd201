# ── Render env vars for the AUTH service ─────────────────────────────────────
# Render dashboard → your auth service → Environment → "Add from .env" → paste.
# Replace every <PLACEHOLDER>. Do NOT commit real secrets.
# (No CORS here — only the gateway is browser-facing.)

# Your SQL Server connection string (e.g. Azure SQL free). Keep it on ONE line.
ConnectionStrings__DefaultConnection=Server=tcp:<YOUR_SERVER>.database.windows.net,1433;Initial Catalog=labdb;User ID=<USER>;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=False;

# JWT settings — MUST be byte-for-byte identical in the Product service.
Jwt__Key=<A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
Jwt__Issuer=MicroserviceLab
Jwt__Audience=MicroserviceLabClients
