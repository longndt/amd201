# ── Render env vars for the FRONTEND (static site) ───────────────────────────
# Render dashboard → your static site → Environment → "Add from .env" → paste.
# These are read at BUILD time by Vite and baked into the bundle, so you must
# trigger a redeploy after changing them.

# The public URLs of your deployed backend services (no trailing slash).
VITE_AUTH_API_URL=https://<your-auth-service>.onrender.com
VITE_PRODUCT_API_URL=https://<your-product-service>.onrender.com
