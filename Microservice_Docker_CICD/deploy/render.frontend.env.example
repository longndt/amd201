# ── Frontend build variable (NOT a Render env var) ───────────────────────────
# The frontend is shipped as a pre-built nginx image. Vite bakes the gateway URL
# into the bundle at BUILD time, which happens in GitHub Actions (see ci-cd.yml).
#
# So you set this in GitHub, NOT on Render:
#   GitHub repo → Settings → Secrets and variables → Actions → Variables → New variable
#     Name:  VITE_API_URL
#     Value: https://<your-gateway>.onrender.com
#
# After changing it, re-run the pipeline so a new frontend image is built & pushed,
# then redeploy the frontend on Render.

VITE_API_URL=https://<your-gateway>.onrender.com
