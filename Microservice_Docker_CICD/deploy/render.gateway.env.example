# ── Render env vars for the API GATEWAY (Ocelot) ─────────────────────────────
# Render dashboard → your gateway service → Environment → "Add from .env" → paste.
# The browser talks ONLY to the gateway, so CORS lives here.

# Loads ocelot.Production.json inside the image.
ASPNETCORE_ENVIRONMENT=Production

# CORS — your deployed frontend URL (scheme + host, no trailing slash).
AllowedOrigins=https://<your-frontend>.onrender.com

# Point the gateway at your deployed services WITHOUT rebuilding the image.
# These override the routes in ocelot.Production.json (host only, no https://).
#   route 0 = /api/auth/*      route 1 = /api/products      route 2 = /api/products/*
Routes__0__DownstreamHostAndPorts__0__Host=<your-auth-service>.onrender.com
Routes__1__DownstreamHostAndPorts__0__Host=<your-product-service>.onrender.com
Routes__2__DownstreamHostAndPorts__0__Host=<your-product-service>.onrender.com
